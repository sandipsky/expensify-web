rules_version = '2';
service firebase.storage {
  // Receipt files (docs/requirements.md §9): a user's own folder only, images
  // or PDFs under 5 MB. Storage needs the Blaze plan (v1.1); until then the
  // web app keeps receipts on the device.
  match /b/{bucket}/o {
    match /users/{uid}/receipts/{transactionId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
